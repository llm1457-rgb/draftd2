<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quest Habits - Gamified Habit Tracker</title>
    <!-- Google Fonts for crisp typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --card-border: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.35);
            --accent-green: #10b981;
            --accent-gold: #f59e0b;
            --accent-red: #ef4444;
            --radius-lg: 20px;
            --radius-md: 12px;
            --radius-sm: 8px;
            --font-family: 'Plus Jakarta Sans', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-family);
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 16px;
        }

        /* Mobile Container Limit */
        .app-container {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding-bottom: 40px;
        }

        /* Header Bar */
        .app-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
        }

        .app-title {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #a5b4fc, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-dev-reset {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--card-border);
            color: var(--text-muted);
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-dev-reset:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-main);
        }

        /* Player Card */
        .player-card {
            background: linear-gradient(145deg, #1e293b, #0f172a);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }

        .player-card::before {
            content: '';
            position: absolute;
            top: 0; right: 0; width: 100px; height: 100px;
            background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
            pointer-events: none;
        }

        .player-profile {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .level-badge {
            width: 58px;
            height: 58px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 15px var(--primary-glow);
            border: 2px solid rgba(255, 255, 255, 0.2);
            flex-shrink: 0;
        }

        .level-label {
            font-size: 0.6rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            opacity: 0.8;
        }

        .level-num {
            font-size: 1.4rem;
            font-weight: 800;
            line-height: 1;
        }

        .player-info {
            flex-grow: 1;
        }

        .player-rank {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .player-subtext {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Progress Bar */
        .xp-bar-container {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            height: 12px;
            border-radius: 6px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .xp-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #6366f1, #10b981);
            border-radius: 6px;
            transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .xp-text {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 6px;
            font-weight: 600;
        }

        /* Action Controls */
        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .filter-chips {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 2px;
            scrollbar-width: none;
        }

        .filter-chip {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .filter-chip.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 4px 12px var(--primary-glow);
        }

        .btn-add {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 12px var(--primary-glow);
            transition: transform 0.1s ease, background 0.2s ease;
            flex-shrink: 0;
        }

        .btn-add:active {
            transform: scale(0.96);
        }

        /* Habit List */
        .habit-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .habit-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-md);
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.25s ease;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .habit-card.completed {
            background: rgba(16, 185, 129, 0.05);
            border-color: rgba(16, 185, 129, 0.3);
        }

        .habit-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .habit-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .habit-details {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .habit-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-main);
            transition: color 0.2s ease;
        }

        .habit-card.completed .habit-title {
            text-decoration: line-through;
            color: var(--text-muted);
        }

        .habit-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .streak-tag {
            color: var(--accent-gold);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 3px;
        }

        /* Check Button */
        .btn-check {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid var(--card-border);
            background: transparent;
            color: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            flex-shrink: 0;
        }

        .habit-card.completed .btn-check {
            background: var(--accent-green);
            border-color: var(--accent-green);
            color: white;
            transform: scale(1.05);
        }

        .btn-delete {
            background: transparent;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 4px;
            font-size: 0.9rem;
            margin-left: 8px;
            opacity: 0.6;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        .btn-delete:hover {
            opacity: 1;
            color: var(--accent-red);
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            background: var(--card-bg);
            border: 1px dashed var(--card-border);
            border-radius: var(--radius-lg);
            color: var(--text-muted);
        }

        .empty-state p {
            font-size: 0.85rem;
            margin-top: 6px;
        }

        /* Modal Backdrop */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            width: 100%;
            max-width: 400px;
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
            transform: translateY(20px);
            transition: transform 0.2s ease;
        }

        .modal-overlay.active .modal {
            transform: translateY(0);
        }

        .modal-title {
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 14px;
        }

        .form-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .form-input, .form-select {
            background: #0f172a;
            border: 1px solid var(--card-border);
            border-radius: var(--radius-sm);
            padding: 10px 12px;
            color: var(--text-main);
            font-size: 0.9rem;
            outline: none;
        }

        .form-input:focus, .form-select:focus {
            border-color: var(--primary);
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--card-border);
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--primary);
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            cursor: pointer;
        }

        /* Level Up Toast Popup */
        .toast-level-up {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 12px 24px;
            border-radius: 30px;
            box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 200;
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .toast-level-up.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- Header -->
        <header class="app-header">
            <h1 class="app-title">QuestHabits</h1>
            <button class="btn-dev-reset" id="btn-next-day" title="Simulate starting a new day">Simulate Next Day ☀️</button>
        </header>

        <!-- Player Level & XP Banner -->
        <section class="player-card">
            <div class="player-profile">
                <div class="level-badge">
                    <span class="level-label">LVL</span>
                    <span class="level-num" id="player-level">1</span>
                </div>
                <div class="player-info">
                    <div class="player-rank" id="player-rank">Novice Adventurer</div>
                    <div class="player-subtext" id="player-summary">Completed 0 habits today</div>
                </div>
            </div>
            
            <div class="xp-bar-container">
                <div class="xp-bar-fill" id="xp-fill"></div>
            </div>
            <div class="xp-text">
                <span id="xp-current">0 XP</span>
                <span id="xp-target">100 XP</span>
            </div>
        </section>

        <!-- Action Bar & Filter -->
        <section class="action-bar">
            <div class="filter-chips" id="category-filters">
                <button class="filter-chip active" data-category="all">All</button>
                <button class="filter-chip" data-category="Health">Health</button>
                <button class="filter-chip" data-category="Mind">Mind</button>
                <button class="filter-chip" data-category="Productivity">Productivity</button>
            </div>
            <button class="btn-add" id="btn-open-modal">+ New</button>
        </section>

        <!-- Habit List -->
        <main class="habit-list" id="habit-list-container">
            <!-- Dynamic habit cards rendered via script.js -->
        </main>
    </div>

    <!-- Add Habit Modal -->
    <div class="modal-overlay" id="add-modal">
        <div class="modal">
            <h2 class="modal-title">Create New Quest</h2>
            <form id="add-habit-form">
                <div class="form-group">
                    <label for="habit-name">Habit Name</label>
                    <input type="text" id="habit-name" class="form-input" placeholder="e.g. Read 15 pages" required maxlength="30">
                </div>
                <div class="form-group">
                    <label for="habit-category">Category</label>
                    <select id="habit-category" class="form-select">
                        <option value="Health">Health 🏋️</option>
                        <option value="Mind">Mind 🧠</option>
                        <option value="Productivity">Productivity ⚡</option>
                    </select>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" id="btn-close-modal">Cancel</button>
                    <button type="submit" class="btn-primary">Add Quest</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Level Up Celebration Banner -->
    <div class="toast-level-up" id="level-up-toast">
        <span>🎉 LEVEL UP! You reached Level <span id="toast-lvl-num">2</span>!</span>
    </div>

    <script>
        // ==========================================
        //        // 1. DATA LAYER (State & LocalStorage)
        // ==========================================
        
        const STORAGE_KEY_DATA = "questhabits_data_v1";

        // Initial default state if no local storage exists
        let appState = {
            player: {
                level: 1,
                xp: 0,
                xpToNextLevel: 100,
                rankTitle: "Novice Adventurer"
            },
            habits: [
                { id: "h1", name: "Drink 2L Water", category: "Health", streak: 1, completedToday: false, icon: "🏋️" },
                { id: "h2", name: "Meditate 5 Mins", category: "Mind", streak: 3, completedToday: false, icon: "🧠" },
                { id: "h3", name: "Review Daily Budget", category: "Productivity", streak: 0, completedToday: false, icon: "⚡" }
            ],
            activeFilter: "all"
        };

        // Rank Titles unlocked by levels
        const RANKS = [
            { minLevel: 1, title: "Novice Adventurer" },
            { minLevel: 3, title: "Consistent Apprentice" },
            { minLevel: 5, title: "Habit Master" },
            { minLevel: 10, title: "Unstoppable Legend" }
        ];

        // ==========================================
        //        // 2. RULES LAYER (Business Logic & Calculations)
        // ==========================================

        /**
         * Calculates XP reward for a habit based on its streak
         * Base XP = 20 XP, + 5 XP extra per day of streak
         */
        function calculateXpReward(streak) {
            return 20 + (streak * 5);
        }

        /**
         * Computes appropriate Rank Title based on current level
         */
        function calculateRankTitle(level) {
            let currentTitle = RANKS[0].title;
            for (const rank of RANKS) {
                if (level >= rank.minLevel) {
                    currentTitle = rank.title;
                }
            }
            return currentTitle;
        }

        /**
         * Logic to toggle a habit completed state and recalculate XP and Streaks
         */
        function toggleHabitRule(habitId) {
            const habit = appState.habits.find(h => h.id === habitId);
            if (!habit) return { leveledUp: false };

            let leveledUp = false;

            if (!habit.completedToday) {
                // Completing habit
                habit.completedToday = true;
                habit.streak += 1;
                
                // Reward XP
                const xpEarned = calculateXpReward(habit.streak);
                appState.player.xp += xpEarned;

                // Check for Level Up
                if (appState.player.xp >= appState.player.xpToNextLevel) {
                    appState.player.xp -= appState.player.xpToNextLevel;
                    appState.player.level += 1;
                    appState.player.xpToNextLevel = appState.player.level * 100;
                    appState.player.rankTitle = calculateRankTitle(appState.player.level);
                    leveledUp = true;
                }
            } else {
                // Unchecking habit (Penalty / Rollback)
                habit.completedToday = false;
                const xpDeducted = calculateXpReward(habit.streak);
                habit.streak = Math.max(0, habit.streak - 1);
                appState.player.xp = Math.max(0, appState.player.xp - xpDeducted);
            }

            saveStateToStorage();
            return { leveledUp };
        }

        /**
         * Add a new habit item to state
         */
        function addHabitRule(name, category) {
            const iconMap = {
                'Health': '🏋️',
                'Mind': '🧠',
                'Productivity': '⚡'
            };

            const newHabit = {
                id: 'h_' + Date.now(),
                name: name.trim(),
                category: category,
                streak: 0,
                completedToday: false,
                icon: iconMap[category] || '🎯'
            };

            appState.habits.push(newHabit);
            saveStateToStorage();
        }

        /**
         * Delete a habit from state
         */
        function deleteHabitRule(habitId) {
            appState.habits = appState.habits.filter(h => h.id !== habitId);
            saveStateToStorage();
        }

        /**
         * STREAMING_CHUNK:Defining storage and state persistence rules...
         * Simulates midnight reset for a new day
         */
        function simulateNextDayRule() {
            appState.habits.forEach(h => {
                if (!h.completedToday) {
                    // Reset streak if missed day
                    h.streak = 0;
                }
                h.completedToday = false;
            });
            saveStateToStorage();
        }

        /**
         * Persistence: Save to LocalStorage
         */
        function saveStateToStorage() {
            try {
                localStorage.setItem(STORAGE_KEY_DATA, JSON.stringify(appState));
            } catch (e) {
                console.error("Could not save to localStorage", e);
            }
        }

        /**
         * Persistence: Load from LocalStorage
         */
        function loadStateFromStorage() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY_DATA);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    // Defensive check to ensure stored object structure matches required schema
                    if (parsed && parsed.player && Array.isArray(parsed.habits)) {
                        appState = {
                            player: {
                                level: parsed.player.level || 1,
                                xp: typeof parsed.player.xp === 'number' ? parsed.player.xp : 0,
                                xpToNextLevel: parsed.player.xpToNextLevel || 100,
                                rankTitle: parsed.player.rankTitle || "Novice Adventurer"
                            },
                            habits: parsed.habits,
                            activeFilter: parsed.activeFilter || "all"
                        };
                    }
                }
            } catch (e) {
                console.error("Could not load from localStorage", e);
            }
        }

        // ==========================================
        //        // 3. DISPLAY LAYER (DOM Rendering & Event Handlers)
        // ==========================================

        // DOM Element Selectors
        const elPlayerLevel = document.getElementById("player-level");
        const elPlayerRank = document.getElementById("player-rank");
        const elPlayerSummary = document.getElementById("player-summary");
        const elXpFill = document.getElementById("xp-fill");
        const elXpCurrent = document.getElementById("xp-current");
        const elXpTarget = document.getElementById("xp-target");
        const elHabitList = document.getElementById("habit-list-container");
        const elFilterChips = document.getElementById("category-filters");
        
        // Modal DOM
        const elAddModal = document.getElementById("add-modal");
        const elBtnOpenModal = document.getElementById("btn-open-modal");
        const elBtnCloseModal = document.getElementById("btn-close-modal");
        const elAddForm = document.getElementById("add-habit-form");
        const elBtnNextDay = document.getElementById("btn-next-day");
        const elLevelUpToast = document.getElementById("level-up-toast");
        const elToastLvlNum = document.getElementById("toast-lvl-num");

        /**
         * STREAMING_CHUNK:Rendering stats and player progression UI...
         * Render Player Stats Card & XP Progress
         */
        function renderPlayerStats() {
            const p = appState.player;
            elPlayerLevel.textContent = p.level;
            elPlayerRank.textContent = p.rankTitle;

            const completedCount = appState.habits.filter(h => h.completedToday).length;
            elPlayerSummary.textContent = `Completed ${completedCount} of ${appState.habits.length} quests today`;

            const xpPct = Math.min(100, Math.floor((p.xp / p.xpToNextLevel) * 100));
            elXpFill.style.width = `${xpPct}%`;
            elXpCurrent.textContent = `${p.xp} XP`;
            elXpTarget.textContent = `${p.xpToNextLevel} XP`;
        }

        /**
         * STREAMING_CHUNK:Rendering habit card list items...
         * Render List of Habit Cards
         */
        function renderHabits() {
            elHabitList.innerHTML = "";

            // Filter habits based on active category
            const filteredHabits = appState.habits.filter(h => {
                if (appState.activeFilter === "all") return true;
                return h.category.toLowerCase() === appState.activeFilter.toLowerCase();
            });

            if (filteredHabits.length === 0) {
                elHabitList.innerHTML = `
                    <div class="empty-state">
                        <div>✨ No active quests</div>
                        <p>Click "+ New" to add a habit quest!</p>
                    </div>
                `;
                return;
            }

            filteredHabits.forEach(habit => {
                const card = document.createElement("div");
                card.className = `habit-card ${habit.completedToday ? 'completed' : ''}`;
                
                card.innerHTML = `
                    <div class="habit-left">
                        <button class="btn-check" data-id="${habit.id}">
                            ${habit.completedToday ? '✓' : ''}
                        </button>
                        <div class="habit-icon">${habit.icon}</div>
                        <div class="habit-details">
                            <div class="habit-title">${escapeHtml(habit.name)}</div>
                            <div class="habit-meta">
                                <span>${habit.category}</span>
                                <span class="streak-tag">🔥 ${habit.streak}d streak</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-delete" data-id="${habit.id}" title="Delete quest">✕</button>
                `;

                elHabitList.appendChild(card);
            });
        }

        /**
         * Helper utility to prevent XSS
         */
        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        /**
         * Shows celebratory toast animation on level up
         */
        function triggerLevelUpToast(newLevel) {
            elToastLvlNum.textContent = newLevel;
            elLevelUpToast.classList.add("show");
            setTimeout(() => {
                elLevelUpToast.classList.remove("show");
            }, 3000);
        }

        /**
         * Re-renders entire UI screen
         */
        function updateUI() {
            renderPlayerStats();
            renderHabits();
        }

        /**
         * STREAMING_CHUNK:Setting up event listeners and interactions...
         * Setup User Event Listeners
         */
        function setupEventListeners() {
            // Habit list interactions (Check toggle & Delete)
            elHabitList.addEventListener("click", (e) => {
                const checkBtn = e.target.closest(".btn-check");
                const deleteBtn = e.target.closest(".btn-delete");

                if (checkBtn) {
                    const habitId = checkBtn.dataset.id;
                    const result = toggleHabitRule(habitId);
                    updateUI();
                    if (result.leveledUp) {
                        triggerLevelUpToast(appState.player.level);
                    }
                } else if (deleteBtn) {
                    const habitId = deleteBtn.dataset.id;
                    deleteHabitRule(habitId);
                    updateUI();
                }
            });

            // Category Filter selection
            elFilterChips.addEventListener("click", (e) => {
                if (e.target.classList.contains("filter-chip")) {
                    document.querySelectorAll(".filter-chip").forEach(chip => chip.classList.remove("active"));
                    e.target.classList.add("active");
                    appState.activeFilter = e.target.dataset.category;
                    renderHabits();
                }
            });

            // Modal Open / Close
            elBtnOpenModal.addEventListener("click", () => elAddModal.classList.add("active"));
            elBtnCloseModal.addEventListener("click", () => elAddModal.classList.remove("active"));

            // Form Submit for New Habit
            elAddForm.addEventListener("submit", (e) => {
                e.preventDefault();
                const name = document.getElementById("habit-name").value;
                const category = document.getElementById("habit-category").value;
                
                addHabitRule(name, category);
                elAddModal.classList.remove("active");
                elAddForm.reset();
                updateUI();
            });

            // Simulate Next Day button
            elBtnNextDay.addEventListener("click", () => {
                simulateNextDayRule();
                updateUI();
            });
        }

        //        // App Initialization
        function initApp() {
            loadStateFromStorage();
            setupEventListeners();
            updateUI();
        }

        // Start the web app safely regardless of DOM loading timing
        if (document.readyState === 'loading') {
            document.addEventListener("DOMContentLoaded", initApp);
        } else {
            initApp();
        }
    </script>
</body>
</html>
